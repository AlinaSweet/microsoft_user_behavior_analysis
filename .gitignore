# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.dask/

# Local configuration and OS noise
.env
.DS_Store

# Source and generated large data must stay out of ordinary Git history
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated bulky artifacts; keep small reports and figures trackable
outputs/**/*.parquet
outputs/**/*.csv
outputs/**/*.feather
