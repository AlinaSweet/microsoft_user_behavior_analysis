# Environments, caches and local configuration
.venv*/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.dask/
.env
.DS_Store

# Large data stay local; metadata and small summaries have separate tracked dirs
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/**/*.parquet
outputs/**/*.feather
# CSV summaries under data/summaries and outputs/reports can now be committed.
